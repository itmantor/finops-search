# این فایل را کپی کنید به نام «.env» و مقادیر را با اطلاعات خودتان پر کنید.
# فایل .env هرگز نباید به اشتراک گذاشته شود یا داخل گیت/ایمیل/تلگرام فرستاده شود.

OPENAI_API_KEY=sk-...

# مسیر فایل ورودی کالاها (CSV یا XLSX) — برای اجرای پایپ‌لاین
INPUT_FILE=data/stuffpubliccode.csv

# مدل‌های OpenAI مورد استفاده
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# پورت اجرای سرور جستجو
PORT=8000
